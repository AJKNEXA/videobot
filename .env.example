BOT_TOKEN=
ADMIN_IDS=
DAILY_LIMIT=5
REFERRALS_NEEDED=3
DELETE_AFTER=600
DB_PATH=videobot.db

# --- Render / production (leave empty for local polling) ---
# Postgres connection string (Supabase/Neon). Empty = local SQLite.
DATABASE_URL=
# Public base URL of the Render web service, e.g.
# https://videobot-xxxx.onrender.com — enables webhook mode.
WEBHOOK_URL=
# Render sets PORT automatically; only used in webhook mode.
PORT=8443
